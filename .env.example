NODE_ENV=local
API_PORT=3000
REALTIME_PORT=3001
CORS_ORIGIN=*
# Public wss:// address the realtime server is actually reachable at (behind a reverse proxy/domain
# in any real deployment) — distinct from REALTIME_PORT, which is just the bind port. Returned in
# POST /streams/:id/start and /viewer-token's `wsUrl` field (05-API-SPEC.md §6). Falls back to a
# local ws://localhost:<REALTIME_PORT> URL when unset.
# PUBLIC_REALTIME_URL=wss://api.example.com

# connection_limit/pool_timeout are tuned up from Prisma's auto-computed default, which is too
# small for real bid-burst concurrency on a single auction (06-REALTIME-AND-CONCURRENCY.md §4) —
# found live in P5-06's 50-simultaneous-bid test, which failed with P2028/P2024 pool-exhaustion
# errors at the defaults even though the row-lock logic itself was correct. Postgres's own
# max_connections (default 100) must stay comfortably above this across all 3 processes combined.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/live_auction?connection_limit=30&pool_timeout=20

REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-32-plus-character-secret-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-32-plus-character-secret-value
JWT_REFRESH_TTL=30d
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Google/Apple sign-in (25 Oct 2026) — all optional. Leave unset and the app boots fine; the
# OAuth routes just return OAUTH_PROVIDER_NOT_CONFIGURED until real values are dropped in here.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://api.example.com/v1/auth/google/callback
# GOOGLE_IOS_CLIENT_ID=
# APPLE_SERVICES_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----
# APPLE_REDIRECT_URI=https://api.example.com/v1/auth/apple/callback
# APPLE_BUNDLE_ID=com.shopaflo.app

STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
STRIPE_PUBLISHABLE_KEY=pk_test_replace

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_BUCKET=live-auction-public
S3_PRIVATE_BUCKET=live-auction-private
CDN_DOMAIN=localhost:9000
# Public media URL scheme. https in production (CloudFront/S3); http for a local MinIO endpoint.
PUBLIC_MEDIA_SCHEME=http

# D-005 (09-DECISIONS.md) resolved to Amazon IVS, 14 Oct 2026 — Classic IVS (Channels: RTMP in,
# HLS out), not Real-Time/Stages, chosen because the real shape is one broadcaster watched by many
# passive viewers, not a handful of interactive participants.
STREAM_PROVIDER=ivs
IVS_REGION=us-east-1
IVS_ACCESS_KEY_ID=replace
IVS_SECRET_ACCESS_KEY=replace

# LiveKit stays supported (STREAM_PROVIDER=livekit) — a one-env-var rollback, not removed code.
LIVEKIT_URL=wss://replace.livekit.cloud
LIVEKIT_API_KEY=replace
LIVEKIT_API_SECRET=replace

DEFAULT_AUCTION_DURATION_SECONDS=30
ANTI_SNIPE_WINDOW_SECONDS=10
ANTI_SNIPE_EXTEND_SECONDS=10
ANTI_SNIPE_MAX_EXTENSIONS=20
OFFER_EXPIRY_SECONDS=300
ORDER_AUTO_CONFIRM_DAYS=7

# RESEND_FROM_EMAIL defaults to Resend's own sandbox sender (works with zero setup, only
# delivers to the account's verified test addresses) — replace with a real verified domain
# address before production.
RESEND_API_KEY=re_replace
RESEND_FROM_EMAIL=onboarding@resend.dev

# Phase 4b db-backup service (docker-compose.prod.yml): nightly pg_dump of the database to S3.
# BACKUP_S3_BUCKET is required on prod (a PRIVATE bucket, S3 lifecycle ~30 days recommended);
# prefix and schedule have sane defaults. Reuses the AWS_* credentials above.
BACKUP_S3_BUCKET=
# BACKUP_S3_PREFIX=db-backups
# BACKUP_CRON=0 3 * * *

# SENTRY_DSN optional (P9-03) — no real Sentry project exists anywhere in this build; omitting
# this is a clean no-op, not an error. Noted here now — missed in P9-03's own .env.example update.
# SENTRY_DSN=
WORKER_METRICS_PORT=9095

# ALERT_EMAIL_TO optional (P9-04) — alerts are still evaluated and logged at CRITICAL without it,
# just not emailed. Every threshold below except ALERT_BID_LATENCY_P95_SECONDS (02-TRD.md §8) is a
# placeholder default, no doc gives a real number — same class as the auto-confirm days/offer
# expiry placeholders above.
# ALERT_EMAIL_TO=
ALERT_SWEEP_INTERVAL_MS=60000
ALERT_COOLDOWN_MINUTES=15
ALERT_QUEUE_DEPTH_THRESHOLD=500
ALERT_JOB_FAILURE_THRESHOLD=5
ALERT_JOB_FAILURE_WINDOW_MINUTES=15
ALERT_WEBHOOK_LAG_THRESHOLD_SECONDS=300
ALERT_BID_LATENCY_P95_SECONDS=0.04


