{
  "expo": {
    "name": "Swish",
    "slug": "shopaflo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "shopaflo",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shopaflo.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Swish uses your camera to scan your card when adding a payment method."
      }
    },
    "android": {
      "package": "com.shopaflo.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-video",
      "expo-notifications",
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": false
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Swish uses your photo library to let you choose a profile picture.",
          "cameraPermission": "Swish uses your camera to let you take a profile picture."
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication"
    ]
  }
}
