// Buyer <-> seller direct messages. Not in the docs either — same gap as reviews, confirmed in
// Phase 8 scoping. One conversation per (buyerUserId, sellerId) pair, not per order: covers the
// founder's "ask a seller a question before buying" case, which has no order yet. Text only —
// attachments need storage, out of scope for this whole integration task. Last-message fields are
// a denormalized inbox-list preview (same shape every inbox-style UI in this app already uses);
// the *Unread booleans flip on each new message for the non-sender side and clear on read,
// deliberately simpler than tracking per-side last-read timestamps.
model Conversation {
  id              String   @id
  buyerUserId     String
  sellerId        String
  lastMessageAt   DateTime @default(now()) @db.Timestamptz(6)
  lastMessageBody String?
  buyerUnread     Boolean  @default(false)
  sellerUnread    Boolean  @default(false)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  messages Message[]

  @@unique([buyerUserId, sellerId])
  @@index([sellerId, lastMessageAt])
  @@index([buyerUserId, lastMessageAt])
}

model Message {
  id             String   @id
  conversationId String
  senderUserId   String
  body           String
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
